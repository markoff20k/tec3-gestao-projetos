generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  admin
  commercial
  projects
}

model User {
  id               String   @id @default(uuid())
  email            String   @unique
  password         String
  name             String
  role             UserRole @default(projects)
  isActive         Boolean  @default(true) @map("is_active")
  professionalCategoryId String? @map("professional_category_id")
  professionalCategory   ProposalCategory? @relation(fields: [professionalCategoryId], references: [id])
  emailGroup        String?  @map("email_group")
  receivesEmails    Boolean  @default(true) @map("receives_emails")
  photoUrl         String?  @map("photo_url")
  photoData        Bytes?   @map("photo_data")
  photoMimeType    String?  @map("photo_mime_type")
  activities       UserActivity[]
  notifications    Notification[]
  
  // Preferências do usuário
  theme            String   @default("light")
  sidebarCollapsed Boolean  @default(false) @map("sidebar_collapsed")
  language         String   @default("pt-BR")
  proposalColumns  Json?    @map("proposal_columns")
  toastPosition    String   @default("bottom-right") @map("toast_position")
  headerShortcutPath String? @map("header_shortcut_path")
  headerShortcutPaths Json?   @map("header_shortcut_paths")

  @@map("users")
}

model Notification {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  type       String
  title      String
  message    String
  link       String?
  sourceKey  String   @unique @map("source_key")
  metadata   Json?
  isActive   Boolean  @default(true) @map("is_active")
  readAt     DateTime? @map("read_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive, readAt])
  @@index([type, isActive, updatedAt])
  @@map("notifications")
}

model UserActivity {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")

  // Categorias: security | profile | preferences | system
  category  String
  // Ação estável (ex.: SECURITY_LOGIN_SUCCESS)
  action    String
  // Texto curto para UI
  title     String
  // Dados adicionais (ex.: campos alterados)
  metadata  Json?    @map("metadata")

  ip        String?  @map("ip")
  userAgent String?  @map("user_agent")

  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@map("user_activities")
}

model Client {
  id                String   @id @default(uuid())
  cnpj              String?
  razaoSocial       String   @map("razao_social")
  nomeFantasia      String?  @map("nome_fantasia")
  pais              String?
  cep               String?
  rua               String?
  numero            String?
  complemento       String?
  bairro            String?
  cidade            String?
  estado            String?
  nomeComercial     String?  @map("nome_comercial")
  emailComercial    String?  @map("email_comercial")
  telefoneComercial String?  @map("telefone_comercial")
  nomeMedicao       String?  @map("nome_medicao")
  emailMedicao      String?  @map("email_medicao")
  telefoneMedicao   String?  @map("telefone_medicao")
  nomeTecnico       String?  @map("nome_tecnico")
  emailTecnico      String?  @map("email_tecnico")
  telefoneTecnico   String?  @map("telefone_tecnico")
  isActive          Boolean  @default(true) @map("is_active")

  proposals         Proposal[]
  projects          Project[]

  @@map("clients")
}

model Proposal {
  id                String    @id @default(uuid())
  code              String
  revision          Int       @default(0)
  title             String
  description       String?
  clientId          String    @map("client_id")
  coordinatorId     String?   @map("coordinator_id")
  coordinatorName   String?   @map("coordinator_name")
  type              String    @default("fixed_price")
  status            String    @default("em_elaboracao")
  totalValue        Decimal   @default(0) @map("total_value") @db.Decimal(12, 2)
  estimatedHours    Int       @default(0) @map("estimated_hours")
  expectedStartDate DateTime? @map("expected_start_date") @db.Date
  expectedEndDate   DateTime? @map("expected_end_date") @db.Date
  projectId         String?   @map("project_id")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime? @updatedAt @map("updated_at")
  sentDate          DateTime? @map("sent_date") @db.Date

  // Campos originais do sistema
  activityType      String?   @map("activity_type")
  umbrellaRef       String?   @map("umbrella_ref")
  utility           String?
  sentByName        String?   @map("sent_by_name")
  specialist        String?
  mainType          String?   @map("main_type")
  quantity          Int?      @default(0)
  hourJustification Decimal?  @map("hour_justification") @db.Decimal(10, 2)
  rehabilitation    Decimal?  @default(0) @db.Decimal(10, 2)
  subcontracted     Decimal?  @default(0) @db.Decimal(10, 2)
  paymentBook       Decimal?  @map("payment_book") @default(0) @db.Decimal(10, 2)
  expense           Decimal?  @default(0) @db.Decimal(10, 2)
  additiveValue     Decimal?  @map("additive_value") @default(0) @db.Decimal(10, 2)
  resource          Decimal?  @default(0) @db.Decimal(10, 2)
  workOrders        String?   @map("work_orders")
  
  // Novos campos do sistema legado
  contractCode      String?   @map("contract_code")
  deliveryDate      DateTime? @map("delivery_date") @db.Date
  dueDate           DateTime? @map("due_date") @db.Date
  duration          String?
  expectation       String?
  termMonths        Int?      @map("term_months")
  hours             Int?
  riskAssessment    String?   @map("risk_assessment")
  maintenanceNum    Int?      @map("maintenance_num")
  acquisitionMargin String?   @map("acquisition_margin")
  anfibex           String?
  discount          String?
  proposalOrigin    String?   @map("proposal_origin")

  client            Client    @relation(fields: [clientId], references: [id])
  categoryValues    ProposalCategoryValue[]
  expenses          ProposalExpense[]
  additives         ProposalAdditive[]

  @@unique([code, revision])
  @@map("proposals")
}

model ProposalAdditive {
  id                String   @id @default(uuid())
  proposalId         String   @map("proposal_id")
  termMonths         Int?     @map("term_months")
  subcontractValue   Decimal  @default(0) @map("subcontract_value") @db.Decimal(12, 2)
  mobilizationValue  Decimal  @default(0) @map("mobilization_value") @db.Decimal(12, 2)
  readjustValue      Decimal  @default(0) @map("readjust_value") @db.Decimal(12, 2)
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime? @updatedAt @map("updated_at")

  proposal           Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@index([proposalId, createdAt])
  @@map("proposal_additives")
}

model ProposalExpense {
  id           String   @id @default(uuid())
  proposalId   String   @map("proposal_id")
  description  String
  value        Decimal  @default(0) @db.Decimal(12, 2)
  reimbursable Boolean  @default(false) @map("reimbursable")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime? @updatedAt @map("updated_at")

  proposal     Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@index([proposalId, createdAt])
  @@map("proposal_expenses")
}

model Project {
  id               String      @id @default(uuid())
  code             String      @unique
  legacyProposalCode String?   @map("legacy_proposal_code")
  legacyRevision   Int?        @map("legacy_revision")
  legacyTermMonths Float?      @map("legacy_term_months")
  name             String
  description      String?
  clientId         String      @map("client_id")
  coordinatorId    String?     @map("coordinator_id")
  status           String      @default("planning")
  startDate        DateTime?   @map("start_date") @db.Date
  endDate          DateTime?   @map("end_date") @db.Date
  budgetHours      Int         @default(0) @map("budget_hours")
  budgetValue      Decimal     @default(0) @map("budget_value") @db.Decimal(12, 2)
  dailyLimitHours  Int         @default(8) @map("daily_limit_hours")
  requiresApproval Boolean     @default(true) @map("requires_approval")
  setupStatus      String      @default("pending") @map("setup_status")
  setupCompletedAt DateTime?   @map("setup_completed_at")
  setupCompletedById String?   @map("setup_completed_by_id")
  tapStatus        String      @default("not_generated") @map("tap_status")
  tapGeneratedAt   DateTime?   @map("tap_generated_at")
  tapSentAt        DateTime?   @map("tap_sent_at")
  tapLastEmailError String?    @map("tap_last_email_error")
  createdAt        DateTime    @default(now()) @map("created_at")

  client           Client      @relation(fields: [clientId], references: [id])
  timeEntries      TimeEntry[]
  taps             ProjectTap[]

  @@map("projects")
}

model ProjectTap {
  id            String   @id @default(uuid())
  projectId     String   @map("project_id")
  version       Int
  title         String
  payload       Json
  htmlContent   String?  @map("html_content")
  generatedById String?  @map("generated_by_id")
  createdAt     DateTime @default(now()) @map("created_at")

  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, version])
  @@index([projectId, createdAt])
  @@map("project_taps")
}

model EmailOutbox {
  id            String   @id @default(uuid())
  type          String
  referenceType String?  @map("reference_type")
  referenceId   String?  @map("reference_id")
  payload       Json
  status        String   @default("pending")
  attemptCount  Int      @default(0) @map("attempt_count")
  lastError     String?  @map("last_error")
  sentAt        DateTime? @map("sent_at")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@index([referenceType, referenceId])
  @@map("email_outbox")
}

model TimeEntry {
  id              String    @id @default(uuid())
  projectId       String    @map("project_id")
  collaboratorId  String    @map("collaborator_id")
  entryDate       DateTime  @map("entry_date") @db.Date
  hours           Decimal   @db.Decimal(4, 2)
  description     String?
  attachments     Json?     @map("attachments")
  status          String    @default("pending")
  approvedById    String?   @map("approved_by_id")
  approvedAt      DateTime? @map("approved_at")
  rejectionReason String?   @map("rejection_reason")
  createdAt       DateTime  @default(now()) @map("created_at")

  project         Project   @relation(fields: [projectId], references: [id])

  @@map("time_entries")
}

model ProposalCategory {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  categoryValues ProposalCategoryValue[]

  professionals  User[]
  @@map("proposal_categories")
}

model ProposalCategoryValue {
  id         String   @id @default(uuid())
  proposalId String   @map("proposal_id")
  categoryId String?  @map("category_id")
  customName String?  @map("custom_name")
  value      Decimal  @default(0) @db.Decimal(12, 2)
  hours      Decimal  @default(0) @db.Decimal(6, 2)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime? @updatedAt @map("updated_at")

  proposal   Proposal  @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  category   ProposalCategory? @relation(fields: [categoryId], references: [id])

  @@map("proposal_category_values")
}

model ProposalFavorite {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  proposalId String   @map("proposal_id")
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([userId, proposalId])
  @@map("proposal_favorites")
}
