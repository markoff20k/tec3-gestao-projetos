# ===========================================
# TEC3 Engenharia - Configuração de Ambiente
# ===========================================
# Copie este arquivo para .env e preencha os valores

# Banco de Dados PostgreSQL
# Formato: postgresql://USUARIO:SENHA@HOST:PORTA/BANCO
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tec3_system
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=tec3_system

# Autenticação JWT
# Use uma chave forte com pelo menos 32 caracteres
JWT_SECRET=sua-chave-secreta-muito-segura-aqui-min-32-caracteres
JWT_EXPIRES_IN=24h

# Sessão Express
SESSION_SECRET=outra-chave-secreta-para-sessao-min-32-caracteres

# Ambiente (development | production)
NODE_ENV=development

# Porta do servidor
PORT=5000
