# ===========================================
# TEC3 Engenharia - Configuração de Ambiente
# ===========================================
# Copie este arquivo para .env e preencha os valores

# Banco de Dados PostgreSQL
# Formato: postgresql://USUARIO:SENHA@HOST:PORTA/BANCO
#DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tec3_system
DATABASE_URL=postgresql://postgres:123456@127.0.0.1:5432/tec3_system
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=tec3_system

# Autenticação JWT
# Use uma chave forte com pelo menos 32 caracteres
JWT_SECRET=a7f9c3d2e1b4a5f8e2d1c4b3a6f9e8d7c2b1a4f3e6d9c8b7a2f1e4d3c6b9a8f7
JWT_EXPIRES_IN=24h

# Sessão Express
SESSION_SECRET=b8e2d1c4a3f6e9d8c7b2a1f4e3d6c9b8a7f2e1d4c3b6a9f8e7d2c1b4a3f6e9d8

# Ambiente (development | production)
NODE_ENV=development

# Porta do servidor
PORT=5000

# ===========================================
# LDAP (AD / OpenLDAP)
# ===========================================
# O login tenta primeiro no AD e, se não encontrar o usuário, tenta OpenLDAP.
# Se a senha estiver errada no primeiro provedor que encontrar o usuário, o login falha (não faz fallback).
#
# Dica (phpLDAPadmin da imagem): seu OpenLDAP parece usar base DN "dc=example,dc=org".

# --- Active Directory (AD)
# Exemplo: ldap://ad.empresa.local:389
LDAP_AD_URL=
# Exemplo: DC=empresa,DC=local
LDAP_AD_BASE_DN=DC=tec3,DC=lan
# Exemplo (conta de serviço): CN=svc_tec3,OU=Service Accounts,DC=empresa,DC=local
LDAP_AD_BIND_DN=
LDAP_AD_BIND_PASSWORD=
# Opcional: domínio AD para compor UPN quando login vier sem domínio (ex.: tec3.lan)
LDAP_AD_DOMAIN=
# Opcional: formato de bind direto do usuário (ex.: %s@tec3.lan ou {{id}}@tec3.lan)
LDAP_AD_BIND_FORMAT=
# Opcional: filtro customizado. Use {{id}} como placeholder.
# Exemplo: (|(userPrincipalName={{id}})(mail={{id}})(sAMAccountName={{id}}))
LDAP_AD_USER_FILTER=

# --- OpenLDAP
# Exemplo: ldap://localhost:389
LDAP_OPENLDAP_URL=ldap://107.23.153.43:389
# Exemplo: dc=example,dc=org
LDAP_OPENLDAP_BASE_DN=dc=example,dc=org
# Exemplo (conta de serviço): cn=admin,dc=example,dc=org
LDAP_OPENLDAP_BIND_DN=
LDAP_OPENLDAP_BIND_PASSWORD=
# Opcional: filtro customizado. Use {{id}} como placeholder.
# Exemplo: (|(mail={{id}})(uid={{id}}))
LDAP_OPENLDAP_USER_FILTER=

# --- Mapeamento de grupos -> role (DNs separados por vírgula)
# Você pode definir o mapeamento global (vale para ambos) OU por provedor.
# Prioridade: variáveis específicas do provedor > variáveis globais.

# (Global)
LDAP_ROLE_ADMIN_DNS=
LDAP_ROLE_COMMERCIAL_DNS=
LDAP_ROLE_PROJECTS_DNS=

# (Específico AD)
LDAP_AD_ROLE_ADMIN_DNS=
LDAP_AD_ROLE_COMMERCIAL_DNS=
LDAP_AD_ROLE_PROJECTS_DNS=

# (Específico OpenLDAP)
LDAP_OPENLDAP_ROLE_ADMIN_DNS=
LDAP_OPENLDAP_ROLE_COMMERCIAL_DNS=
LDAP_OPENLDAP_ROLE_PROJECTS_DNS=
