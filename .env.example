# ===========================================
# TEC3 Engenharia - Configuração de Ambiente
# ===========================================
# Copie este arquivo para .env e preencha os valores

# Banco de Dados PostgreSQL
# Formato: postgresql://USUARIO:SENHA@HOST:PORTA/BANCO
#DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tec3_system
DATABASE_URL=postgresql://postgres:123456@127.0.0.1:5432/tec3_system
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=tec3_system

# Autenticação JWT
# Use uma chave forte com pelo menos 32 caracteres
JWT_SECRET=a7f9c3d2e1b4a5f8e2d1c4b3a6f9e8d7c2b1a4f3e6d9c8b7a2f1e4d3c6b9a8f7
JWT_EXPIRES_IN=24h

# Sessão Express
SESSION_SECRET=b8e2d1c4a3f6e9d8c7b2a1f4e3d6c9b8a7f2e1d4c3b6a9f8e7d2c1b4a3f6e9d8

# Ambiente (development | production)
NODE_ENV=development

# Porta do servidor
PORT=5000
